# Copy to .env and fill in real values locally. .env is git-ignored.
# Never commit real secrets — this file only documents required keys.

LUMINA_ENV=Development

# Connection string for local SQLite (Development) or Postgres/SQL Server (Staging/Prod)
LUMINA_DB_CONNECTION=Data Source=lumina.dev.db

# AEAT VeriFactu client certificate (path + passphrase), Staging/Prod only
AEAT_CLIENT_CERT_PATH=
AEAT_CLIENT_CERT_PASSPHRASE=
AEAT_ENVIRONMENT=sandbox   # sandbox | production

# Symmetric key used to encrypt local config at rest
LUMINA_CONFIG_ENCRYPTION_KEY=
