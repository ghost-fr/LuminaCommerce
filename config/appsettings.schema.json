{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lumina appsettings schema",
  "type": "object",
  "properties": {
    "Lumina": {
      "type": "object",
      "properties": {
        "Environment": { "type": "string", "enum": ["Development", "Staging", "Production"] },
        "Database": {
          "type": "object",
          "properties": {
            "Provider": { "type": "string", "enum": ["Sqlite", "Postgres", "SqlServer"] },
            "ConnectionStringEnvVar": { "type": "string" }
          },
          "required": ["Provider", "ConnectionStringEnvVar"]
        },
        "VeriFactu": {
          "type": "object",
          "properties": {
            "Mode": { "type": "string", "enum": ["Disabled", "VeriFactu", "NonVeriFactu"] },
            "SifBoundary": { "type": "string", "enum": ["PerCompany", "PerStore", "PerTerminal"] }
          },
          "required": ["Mode", "SifBoundary"]
        }
      },
      "required": ["Environment", "Database", "VeriFactu"]
    }
  },
  "required": ["Lumina"]
}
