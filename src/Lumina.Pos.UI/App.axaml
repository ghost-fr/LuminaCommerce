<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumina.Pos.UI.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <Color x:Key="Color.Brand">#E8A317</Color>
        <Color x:Key="Color.Primary">#0F6B45</Color>
        <Color x:Key="Color.PrimaryHover">#0C5537</Color>
        <Color x:Key="Color.PrimarySoft">#E6F4ED</Color>
        <Color x:Key="Color.Ink">#111827</Color>
        <Color x:Key="Color.InkMuted">#4B5563</Color>
        <Color x:Key="Color.InkFaint">#9CA3AF</Color>
        <Color x:Key="Color.Line">#E5E7EB</Color>
        <Color x:Key="Color.LineStrong">#D1D5DB</Color>
        <Color x:Key="Color.Surface">#FFFFFF</Color>
        <Color x:Key="Color.Canvas">#F3F4F6</Color>
        <Color x:Key="Color.Danger">#DC2626</Color>
        <Color x:Key="Color.Success">#059669</Color>

        <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
        <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
        <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
        <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource Color.PrimarySoft}" />
        <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
        <SolidColorBrush x:Key="Brush.InkMuted" Color="{StaticResource Color.InkMuted}" />
        <SolidColorBrush x:Key="Brush.InkFaint" Color="{StaticResource Color.InkFaint}" />
        <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
        <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />
        <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
        <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
        <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
        <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource Brush.Canvas}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, system-ui, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brush.PrimaryHover}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.key">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.fkey">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.LineStrong}" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.InkMuted}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource Brush.InkFaint}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Border.pill-ok">
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Application.Styles>
</Application>
