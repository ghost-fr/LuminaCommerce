<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumina.Pos.UI.App">
    <Application.Styles>
        <FluentTheme />

        <!-- Lumina design tokens (aligned to Figma: green primary, orange brand, light chrome) -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1B7A4E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#16653F" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3D4A5C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="8,1" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#E8F5EE" />
            <Setter Property="Foreground" Value="#1B7A4E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#E6EBF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Application.Styles>
</Application>
