<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource Brush.Canvas}">
  <DockPanel>

    <!-- SIDEBAR -->
    <Border DockPanel.Dock="Left" Width="212" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="16,18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Brush.Brand}">
              <TextBlock Text="L" FontSize="16" FontWeight="Bold" Foreground="#111827"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Lumina" FontSize="14" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="Commerce" FontSize="10" Foreground="#9CA3AF" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,12" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
              <Border Width="32" Height="32" CornerRadius="999" Background="{StaticResource Brush.PrimarySoft}">
                <TextBlock Text="{Binding UserInitial}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource Brush.Primary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Username}" Classes="muted" />
              </StackPanel>
            </StackPanel>
            <Button Classes="nav" Command="{Binding LogoutCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⎋" Width="18" TextAlignment="Center" />
                <TextBlock Text="Cerrar sesión" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,8">
          <StackPanel>
            <Button Classes="nav" Classes.active="{Binding IsNavInicio}" Command="{Binding NavigateCommand}" CommandParameter="inicio">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⌂" Width="18" TextAlignment="Center"/><TextBlock Text="Inicio"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavTpv}" Command="{Binding NavigateCommand}" CommandParameter="tpv" IsVisible="{Binding CanOperatePos}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▣" Width="18" TextAlignment="Center"/><TextBlock Text="TPV"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavVentas}" Command="{Binding NavigateCommand}" CommandParameter="ventas" IsVisible="{Binding CanViewReports}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="↗" Width="18" TextAlignment="Center"/><TextBlock Text="Ventas"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavClientes}" Command="{Binding NavigateCommand}" CommandParameter="clientes">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◎" Width="18" TextAlignment="Center"/><TextBlock Text="Clientes"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavArticulos}" Command="{Binding NavigateCommand}" CommandParameter="articulos" IsVisible="{Binding CanManageCatalogue}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▦" Width="18" TextAlignment="Center"/><TextBlock Text="Artículos"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavStock}" Command="{Binding NavigateCommand}" CommandParameter="stock" IsVisible="{Binding CanAdjustStock}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▤" Width="18" TextAlignment="Center"/><TextBlock Text="Stock"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavCompras}" Command="{Binding NavigateCommand}" CommandParameter="compras" IsVisible="{Binding CanAdjustStock}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⬇" Width="18" TextAlignment="Center"/><TextBlock Text="Compras"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavCaja}" Command="{Binding NavigateCommand}" CommandParameter="caja" IsVisible="{Binding CanOperatePos}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="€" Width="18" TextAlignment="Center"/><TextBlock Text="Caja"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavInformes}" Command="{Binding NavigateCommand}" CommandParameter="informes" IsVisible="{Binding CanViewReports}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="☰" Width="18" TextAlignment="Center"/><TextBlock Text="Informes"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavVerifactu}" Command="{Binding NavigateCommand}" CommandParameter="verifactu" IsVisible="{Binding CanManageFiscal}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="✓" Width="18" TextAlignment="Center"/><TextBlock Text="VeriFactu"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavUsuarios}" Command="{Binding NavigateCommand}" CommandParameter="usuarios" IsVisible="{Binding CanManageUsers}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="☷" Width="18" TextAlignment="Center"/><TextBlock Text="Usuarios"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavConfig}" Command="{Binding NavigateCommand}" CommandParameter="config" IsVisible="{Binding CanManageUsers}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⚙" Width="18" TextAlignment="Center"/><TextBlock Text="Configuración"/></StackPanel>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsNavAyuda}" Command="{Binding NavigateCommand}" CommandParameter="ayuda">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="?" Width="18" TextAlignment="Center"/><TextBlock Text="Ayuda"/></StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ================= CONTENT ================= -->
    <Grid>

      <!-- INICIO -->
      <ScrollViewer IsVisible="{Binding IsInicio}" Padding="20,18">
        <StackPanel Spacing="14" DataContext="{Binding Reports}">
          <TextBlock Text="Inicio" Classes="section-title" />
          <UniformGrid Columns="4">
            <Border Classes="card" Margin="0,0,10,0"><StackPanel Spacing="4"><TextBlock Text="Ventas hoy" Classes="caption"/><TextBlock Text="{Binding SalesTotal, StringFormat='{}{0:N2} €'}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Datos de demostración" Classes="muted"/></StackPanel></Border>
            <Border Classes="card" Margin="0,0,10,0"><StackPanel Spacing="4"><TextBlock Text="Tickets hoy" Classes="caption"/><TextBlock Text="{Binding TicketCount}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Datos de demostración" Classes="muted"/></StackPanel></Border>
            <Border Classes="card" Margin="0,0,10,0"><StackPanel Spacing="4"><TextBlock Text="Ticket medio" Classes="caption"/><TextBlock Text="{Binding AvgTicket, StringFormat='{}{0:N2} €'}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Datos de demostración" Classes="muted"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="4"><TextBlock Text="Clientes hoy" Classes="caption"/><TextBlock Text="{Binding CustomerCount}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Datos de demostración" Classes="muted"/></StackPanel></Border>
          </UniformGrid>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Accesos rápidos" FontWeight="SemiBold"/>
              <WrapPanel DataContext="{Binding $parent[UserControl].DataContext}">
                <Button Classes="secondary" Margin="0,0,8,8" Content="Nueva venta · F2" Command="{Binding NavigateCommand}" CommandParameter="tpv" IsVisible="{Binding CanOperatePos}"/>
                <Button Classes="secondary" Margin="0,0,8,8" Content="Artículos · F4" Command="{Binding NavigateCommand}" CommandParameter="articulos" IsVisible="{Binding CanManageCatalogue}"/>
                <Button Classes="secondary" Margin="0,0,8,8" Content="Clientes · F3" Command="{Binding NavigateCommand}" CommandParameter="clientes"/>
                <Button Classes="secondary" Margin="0,0,8,8" Content="Caja · F12" Command="{Binding NavigateCommand}" CommandParameter="caja" IsVisible="{Binding CanOperatePos}"/>
                <Button Classes="secondary" Margin="0,0,8,8" Content="VeriFactu" Command="{Binding NavigateCommand}" CommandParameter="verifactu" IsVisible="{Binding CanManageFiscal}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- TPV -->
      <Grid IsVisible="{Binding IsTpv}" RowDefinitions="Auto,*,Auto" Margin="14" DataContext="{Binding Pos}">
        <Border Grid.Row="0" Classes="card" Padding="12,10" Margin="0,0,0,10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="Tienda 001" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="Caja 01" Classes="caption" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CustomerLabel}" Classes="caption" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox Grid.Column="1" Classes="field" Watermark="Código de barras o nombre…" Text="{Binding BarcodeInput}" Margin="12,0"/>
            <Button Grid.Column="2" Classes="primary" Content="Añadir" Command="{Binding AddByBarcodeCommand}" Padding="20,10"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,300">
          <Border Classes="card" Margin="0,0,10,0" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#F9FAFB" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid ColumnDefinitions="90,*,70,80,60,90">
                  <TextBlock Text="Código" Classes="caption" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="Descripción" Classes="caption" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="2" Text="Cant." Classes="caption" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="3" Text="Precio" Classes="caption" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="4" Text="Dto." Classes="caption" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="5" Text="Total" Classes="caption" FontWeight="SemiBold"/>
                </Grid>
              </Border>
              <ListBox ItemsSource="{Binding Lines}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="90,*,70,80,60,90" Margin="12,6">
                      <TextBlock Text="{Binding Code}"/><TextBlock Grid.Column="1" Text="{Binding Name}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Qty, StringFormat='{}{0:0.##}'}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat='{}{0:0.00}'}"/>
                      <TextBlock Grid.Column="4" Text="{Binding DiscountPct, StringFormat='{}{0:0}%'}"/>
                      <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='{}{0:0.00}'}" FontWeight="SemiBold"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Total" Classes="caption"/>
                <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="12">
              <StackPanel Spacing="6">
                <UniformGrid Columns="3">
                  <Button Classes="key" Content="7" Command="{Binding KeyDigitCommand}" CommandParameter="7"/>
                  <Button Classes="key" Content="8" Command="{Binding KeyDigitCommand}" CommandParameter="8"/>
                  <Button Classes="key" Content="9" Command="{Binding KeyDigitCommand}" CommandParameter="9"/>
                  <Button Classes="key" Content="4" Command="{Binding KeyDigitCommand}" CommandParameter="4"/>
                  <Button Classes="key" Content="5" Command="{Binding KeyDigitCommand}" CommandParameter="5"/>
                  <Button Classes="key" Content="6" Command="{Binding KeyDigitCommand}" CommandParameter="6"/>
                  <Button Classes="key" Content="1" Command="{Binding KeyDigitCommand}" CommandParameter="1"/>
                  <Button Classes="key" Content="2" Command="{Binding KeyDigitCommand}" CommandParameter="2"/>
                  <Button Classes="key" Content="3" Command="{Binding KeyDigitCommand}" CommandParameter="3"/>
                  <Button Classes="key" Content="0" Command="{Binding KeyDigitCommand}" CommandParameter="0"/>
                  <Button Classes="key" Content="C" Command="{Binding KeyClearCommand}"/>
                  <Button Classes="key" Content="⌫" Command="{Binding RemoveLastCommand}"/>
                </UniformGrid>
                <Button Classes="secondary" Content="Vaciar ticket" Command="{Binding ClearCartCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"/>
                <Button Classes="primary" Content="Cobrar (mock)" Command="{Binding CompleteMockSaleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="46"/>
              </StackPanel>
            </Border>
          </DockPanel>
        </Grid>

        <Border Grid.Row="2" Classes="card" Margin="0,10,0,0" Padding="10,8" DataContext="{Binding $parent[UserControl].DataContext}">
          <WrapPanel>
            <Button Classes="fkey" Content="F2 Ticket" Command="{Binding Pos.CompleteMockSaleCommand}"/>
            <Button Classes="fkey" Content="F3 Clientes" Command="{Binding NavigateCommand}" CommandParameter="clientes"/>
            <Button Classes="fkey" Content="F4 Artículos" Command="{Binding NavigateCommand}" CommandParameter="articulos"/>
            <Button Classes="fkey" Content="Esc Inicio" Command="{Binding NavigateCommand}" CommandParameter="inicio"/>
          </WrapPanel>
        </Border>
      </Grid>

      <!-- ARTÍCULOS -->
      <DockPanel IsVisible="{Binding IsArticulos}" Margin="18" DataContext="{Binding Products}">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
          <TextBlock Text="Artículos" Classes="section-title"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="field" Watermark="Buscar por código, nombre o familia…" Text="{Binding Search}"/>
            <Button Grid.Column="1" Classes="secondary" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
          </Grid>
        </StackPanel>
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                    IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                    BorderThickness="0" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Familia" Binding="{Binding Family}" Width="120"/>
              <DataGridTextColumn Header="PVP" Binding="{Binding Price, StringFormat='{}{0:0.00} €'}" Width="90"/>
              <DataGridTextColumn Header="IVA" Binding="{Binding Vat, StringFormat='{}{0:P0}'}" Width="70"/>
              <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
              <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>

      <!-- CLIENTES -->
      <DockPanel IsVisible="{Binding IsClientes}" Margin="18" DataContext="{Binding Customers}">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
          <TextBlock Text="Clientes" Classes="section-title"/>
          <TextBox Classes="field" Watermark="Buscar por nombre, NIF o teléfono…" Text="{Binding Search}"/>
        </StackPanel>
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"/>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="120"/>
              <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="120"/>
              <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat='{}{0:N2} €'}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>

      <!-- VENTAS -->
      <DockPanel IsVisible="{Binding IsVentas}" Margin="18" DataContext="{Binding Sales}">
        <TextBlock DockPanel.Dock="Top" Text="Ventas / Tickets" Classes="section-title" Margin="0,0,0,12"/>
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nº Ticket" Binding="{Binding Number}" Width="100"/>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="110"/>
              <DataGridTextColumn Header="Hora" Binding="{Binding Time}" Width="80"/>
              <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N2} €'}" Width="100"/>
              <DataGridTextColumn Header="Empleado" Binding="{Binding Employee}" Width="100"/>
              <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>

      <!-- STOCK -->
      <DockPanel IsVisible="{Binding IsStock}" Margin="18" DataContext="{Binding Stock}">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
          <TextBlock Text="Stock" Classes="section-title"/>
          <TextBlock Text="Niveles actuales y movimientos recientes (datos de demostración)." Classes="caption"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,*">
          <Border Classes="card" Margin="0,0,8,0" Padding="0">
            <DataGrid ItemsSource="{Binding Levels}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="0">
            <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding When}" Width="130"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding ProductCode}" Width="90"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding Qty}" Width="60"/>
                <DataGridTextColumn Header="Saldo" Binding="{Binding BalanceAfter}" Width="60"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </DockPanel>

      <!-- COMPRAS -->
      <DockPanel IsVisible="{Binding IsCompras}" Margin="18" DataContext="{Binding Purchases}">
        <TextBlock DockPanel.Dock="Top" Text="Compras y proveedores" Classes="section-title" Margin="0,0,0,12"/>
        <Grid RowDefinitions="*,*">
          <Border Classes="card" Margin="0,0,0,8" Padding="0">
            <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding Number}" Width="120"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Supplier}" Width="*"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="110"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N2} €'}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Border Grid.Row="1" Classes="card" Padding="0">
            <DataGrid ItemsSource="{Binding Suppliers}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Pedidos abiertos" Binding="{Binding OpenOrders}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </DockPanel>

      <!-- CAJA -->
      <ScrollViewer IsVisible="{Binding IsCaja}" Padding="20" DataContext="{Binding Cash}">
        <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Caja" Classes="section-title"/>
          <TextBlock Text="{Binding Status}" Classes="caption"/>
          <Border Classes="card"><StackPanel Spacing="10">
            <DockPanel><TextBlock Text="Fondo de apertura"/><TextBlock DockPanel.Dock="Right" Text="{Binding OpeningFloat, StringFormat='{}{0:N2} €'}" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
            <DockPanel><TextBlock Text="Ventas efectivo"/><TextBlock DockPanel.Dock="Right" Text="{Binding CashSales, StringFormat='{}{0:N2} €'}" HorizontalAlignment="Right"/></DockPanel>
            <DockPanel><TextBlock Text="Ventas tarjeta"/><TextBlock DockPanel.Dock="Right" Text="{Binding CardSales, StringFormat='{}{0:N2} €'}" HorizontalAlignment="Right"/></DockPanel>
            <Border Height="1" Background="{StaticResource Brush.Line}"/>
            <DockPanel><TextBlock Text="Efectivo esperado" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding ExpectedCash, StringFormat='{}{0:N2} €'}" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel>
            <DockPanel><TextBlock Text="En cajón (contado)"/><TextBlock DockPanel.Dock="Right" Text="{Binding CashInDrawer, StringFormat='{}{0:N2} €'}" HorizontalAlignment="Right"/></DockPanel>
            <Button Classes="primary" Content="Cerrar caja (simulado)" Command="{Binding CloseRegisterCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>

      <!-- INFORMES -->
      <ScrollViewer IsVisible="{Binding IsInformes}" Padding="20" DataContext="{Binding Reports}">
        <StackPanel Spacing="14">
          <TextBlock Text="Informes" Classes="section-title"/>
          <UniformGrid Columns="4">
            <Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="Ventas" Classes="caption"/><TextBlock Text="{Binding SalesTotal, StringFormat='{}{0:N2} €'}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="Tickets" Classes="caption"/><TextBlock Text="{Binding TicketCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="Ticket medio" Classes="caption"/><TextBlock Text="{Binding AvgTicket, StringFormat='{}{0:N2} €'}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Text="Clientes" Classes="caption"/><TextBlock Text="{Binding CustomerCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Los read models de reporting se conectarán en la Fase 7 del backend." Classes="muted"/>
        </StackPanel>
      </ScrollViewer>

      <!-- USUARIOS -->
      <DockPanel IsVisible="{Binding IsUsuarios}" Margin="18" DataContext="{Binding Users}">
        <TextBlock DockPanel.Dock="Top" Text="Usuarios y roles" Classes="section-title" Margin="0,0,0,12"/>
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="120"/>
              <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="160"/>
              <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="100"/>
              <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="70"/>
              <DataGridTextColumn Header="Capacidades" Binding="{Binding Capabilities}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>

      <!-- CONFIG -->
      <ScrollViewer IsVisible="{Binding IsConfig}" Padding="20" DataContext="{Binding Settings}">
        <StackPanel Spacing="12" MaxWidth="480">
          <TextBlock Text="Configuración" Classes="section-title"/>
          <TextBlock Text="Nombre de tienda" Classes="caption"/><TextBox Classes="field" Text="{Binding StoreName}"/>
          <TextBlock Text="NIF" Classes="caption"/><TextBox Classes="field" Text="{Binding Nif}"/>
          <TextBlock Text="Límite SIF (cadena hash)" Classes="caption"/><TextBox Classes="field" Text="{Binding SifBoundary}"/>
          <CheckBox IsChecked="{Binding VeriFactuMode}" Content="Modo VERI*FACTU activo" Margin="0,8,0,0"/>
          <TextBlock Text="Impresora de tickets" Classes="caption"/><TextBox Classes="field" Text="{Binding TicketPrinter}"/>
          <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding StatusMessage}" Classes="muted"/>
        </StackPanel>
      </ScrollViewer>

      <!-- VERIFACTU -->
      <DockPanel IsVisible="{Binding IsVerifactu}" Margin="18" DataContext="{Binding VeriFactu}">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
          <TextBlock Text="VeriFactu" Classes="section-title"/>
          <UniformGrid Columns="4">
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Text="Emitidos" Classes="caption"/><TextBlock Text="{Binding Emitted}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Text="Aceptados" Classes="caption"/><TextBlock Text="{Binding Accepted}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}"/></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Text="Pendientes" Classes="caption"/><TextBlock Text="{Binding Pending}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Text="Rechazados" Classes="caption"/><TextBlock Text="{Binding Rejected}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="{Binding ConnectionStatus}" Classes="caption"/>
        </StackPanel>
        <Border Classes="card" Padding="0">
          <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nº Factura" Binding="{Binding InvoiceNo}" Width="140"/>
              <DataGridTextColumn Header="Fecha" Binding="{Binding When}" Width="140"/>
              <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat='{}{0:N2} €'}" Width="100"/>
              <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="140"/>
              <DataGridTextColumn Header="Resp. AEAT" Binding="{Binding AeatCode}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </DockPanel>

      <!-- AYUDA -->
      <ScrollViewer IsVisible="{Binding IsAyuda}" Padding="24">
        <StackPanel Spacing="12" MaxWidth="560">
          <TextBlock Text="Ayuda" Classes="section-title"/>
          <TextBlock Text="Atajos de teclado (TPV)" FontWeight="SemiBold"/>
          <TextBlock Text="F2 — Cobrar ticket (mock)&#x0a;F3 — Clientes&#x0a;F4 — Artículos&#x0a;Esc — Volver a Inicio" Classes="caption"/>
          <TextBlock Text="Arquitectura" FontWeight="SemiBold" Margin="0,12,0,0"/>
          <TextBlock Text="La UI se enlaza a Lumina.Contracts. El cobro fiscal real usa IPosSaleService + VeriFactu. Los listados usan datos de demostración hasta que existan read models." Classes="caption" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </DockPanel>
</UserControl>
