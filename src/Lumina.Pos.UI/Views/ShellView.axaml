<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource Brush.Canvas}">
    <DockPanel>

        <!-- SIDEBAR -->
        <Border DockPanel.Dock="Left" Width="212" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#111827" Padding="16,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Brush.Brand}">
                            <TextBlock Text="L" FontSize="16" FontWeight="Bold" Foreground="#111827"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Lumina" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Commerce" FontSize="10" Foreground="#9CA3AF" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="10,12" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,8,4">
                            <Border Width="32" Height="32" CornerRadius="999" Background="{StaticResource Brush.PrimarySoft}">
                                <TextBlock Text="{Binding UserInitial}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource Brush.Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Username}" Classes="muted" />
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="nav" Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⎋" Width="18" TextAlignment="Center" Opacity="0.7" />
                                <TextBlock Text="Cerrar sesión" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,8">
                    <StackPanel>
                        <Button Classes="nav" Classes.active="{Binding IsNavInicio}"
                                Command="{Binding NavigateCommand}" CommandParameter="inicio">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⌂" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Inicio" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavTpv}"
                                Command="{Binding NavigateCommand}" CommandParameter="tpv"
                                IsVisible="{Binding CanOperatePos}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▣" Width="18" TextAlignment="Center" />
                                <TextBlock Text="TPV" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavVentas}"
                                Command="{Binding NavigateCommand}" CommandParameter="ventas"
                                IsVisible="{Binding CanViewReports}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="↗" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Ventas" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavClientes}"
                                Command="{Binding NavigateCommand}" CommandParameter="clientes">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="◎" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Clientes" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavArticulos}"
                                Command="{Binding NavigateCommand}" CommandParameter="articulos"
                                IsVisible="{Binding CanManageCatalogue}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▦" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Artículos" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavStock}"
                                Command="{Binding NavigateCommand}" CommandParameter="stock"
                                IsVisible="{Binding CanAdjustStock}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▤" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Stock" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavInformes}"
                                Command="{Binding NavigateCommand}" CommandParameter="informes"
                                IsVisible="{Binding CanViewReports}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="☰" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Informes" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavVerifactu}"
                                Command="{Binding NavigateCommand}" CommandParameter="verifactu"
                                IsVisible="{Binding CanManageFiscal}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="✓" Width="18" TextAlignment="Center" />
                                <TextBlock Text="VeriFactu" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavCaja}"
                                Command="{Binding NavigateCommand}" CommandParameter="caja"
                                IsVisible="{Binding CanOperatePos}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="€" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Caja" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavConfig}"
                                Command="{Binding NavigateCommand}" CommandParameter="config"
                                IsVisible="{Binding CanManageUsers}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚙" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Configuración" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavUsuarios}"
                                Command="{Binding NavigateCommand}" CommandParameter="usuarios"
                                IsVisible="{Binding CanManageUsers}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="☷" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Usuarios" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsNavAyuda}"
                                Command="{Binding NavigateCommand}" CommandParameter="ayuda">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="?" Width="18" TextAlignment="Center" />
                                <TextBlock Text="Ayuda" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- CONTENT -->
        <Grid>

            <!-- INICIO -->
            <ScrollViewer IsVisible="{Binding IsInicio}" Padding="20,18">
                <StackPanel Spacing="14">
                    <DockPanel>
                        <TextBlock Text="Inicio" Classes="section-title" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Panel de control" Classes="caption"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </DockPanel>

                    <UniformGrid Columns="4">
                        <Border Classes="card" Margin="0,0,10,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ventas hoy" Classes="caption" />
                                <TextBlock Text="—" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Disponible en reporting (Fase 7)" Classes="muted" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,10,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Tickets hoy" Classes="caption" />
                                <TextBlock Text="—" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Disponible en reporting (Fase 7)" Classes="muted" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Margin="0,0,10,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ticket medio" Classes="caption" />
                                <TextBlock Text="—" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Disponible en reporting (Fase 7)" Classes="muted" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Clientes hoy" Classes="caption" />
                                <TextBlock Text="—" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Disponible en reporting (Fase 7)" Classes="muted" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid ColumnDefinitions="*,280" Margin="0,2,0,0">
                        <Border Classes="card" Margin="0,0,12,0" MinHeight="240">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Gráfico de ventas (hoy)" FontWeight="SemiBold" />
                                <Border Background="{StaticResource Brush.Canvas}" CornerRadius="8" Height="170">
                                    <TextBlock Text="Los datos de ventas se conectarán en la fase de reporting"
                                               Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" MinHeight="240">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Estado del sistema" FontWeight="SemiBold" />
                                <DockPanel>
                                    <TextBlock Text="VeriFactu" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Classes="pill-ok" HorizontalAlignment="Right">
                                        <TextBlock Text="Activo" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Success}" />
                                    </Border>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Conexión AEAT" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Classes="pill-warn" HorizontalAlignment="Right">
                                        <TextBlock Text="Pendiente" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.InkMuted}" />
                                    </Border>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Último envío" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="—" Classes="caption" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource Brush.Line}" Margin="0,4" />
                                <TextBlock Text="Sesión" Classes="caption" />
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Username}" Classes="muted" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Accesos rápidos" FontWeight="SemiBold" />
                            <WrapPanel>
                                <Button Classes="secondary" Margin="0,0,8,8" Content="Nueva venta  ·  F2"
                                        Command="{Binding NavigateCommand}" CommandParameter="tpv"
                                        IsVisible="{Binding CanOperatePos}" />
                                <Button Classes="secondary" Margin="0,0,8,8" Content="Buscar artículo  ·  F4"
                                        Command="{Binding NavigateCommand}" CommandParameter="articulos"
                                        IsVisible="{Binding CanManageCatalogue}" />
                                <Button Classes="secondary" Margin="0,0,8,8" Content="Clientes  ·  F3"
                                        Command="{Binding NavigateCommand}" CommandParameter="clientes" />
                                <Button Classes="secondary" Margin="0,0,8,8" Content="Cierre de caja  ·  F12"
                                        Command="{Binding NavigateCommand}" CommandParameter="caja"
                                        IsVisible="{Binding CanOperatePos}" />
                                <Button Classes="secondary" Margin="0,0,8,8" Content="VeriFactu"
                                        Command="{Binding NavigateCommand}" CommandParameter="verifactu"
                                        IsVisible="{Binding CanManageFiscal}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TPV -->
            <Grid IsVisible="{Binding IsTpv}" RowDefinitions="Auto,*,Auto" Margin="14">
                <Border Grid.Row="0" Classes="card" Padding="12,10" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                            <TextBlock Text="Tienda" Classes="caption" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Brush.Canvas}" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="001" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                            <TextBlock Text="Caja" Classes="caption" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Brush.Canvas}" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="01" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,18,0">
                            <TextBlock Text="Empleado" Classes="caption" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Grid.Column="3" Classes="field" Watermark="Buscar cliente por nombre, NIF o teléfono…" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="4" Text="Tarifa" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border Grid.Column="5" Background="{StaticResource Brush.Canvas}" CornerRadius="6" Padding="12,7">
                            <TextBlock Text="General" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,300">
                    <Border Classes="card" Margin="0,0,10,0" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#F9FAFB" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="90,*,70,80,60,90" Margin="12,0">
                                    <TextBlock Text="Código" Classes="caption" FontWeight="SemiBold" Margin="0,10" />
                                    <TextBlock Grid.Column="1" Text="Descripción" Classes="caption" FontWeight="SemiBold" Margin="0,10" />
                                    <TextBlock Grid.Column="2" Text="Cant." Classes="caption" FontWeight="SemiBold" Margin="0,10" />
                                    <TextBlock Grid.Column="3" Text="Precio" Classes="caption" FontWeight="SemiBold" Margin="0,10" />
                                    <TextBlock Grid.Column="4" Text="Dto." Classes="caption" FontWeight="SemiBold" Margin="0,10" />
                                    <TextBlock Grid.Column="5" Text="Total" Classes="caption" FontWeight="SemiBold" Margin="0,10" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="24">
                                <TextBlock Text="Carrito vacío" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Escanea un código de barras o pulsa F4 para buscar un artículo."
                                           Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Total" Classes="caption" />
                                <TextBlock Text="0,00 €" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Primary}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBox Classes="field" Watermark="Código de barras" />
                                <UniformGrid Columns="3">
                                    <Button Classes="key" Content="7" /><Button Classes="key" Content="8" /><Button Classes="key" Content="9" />
                                    <Button Classes="key" Content="4" /><Button Classes="key" Content="5" /><Button Classes="key" Content="6" />
                                    <Button Classes="key" Content="1" /><Button Classes="key" Content="2" /><Button Classes="key" Content="3" />
                                    <Button Classes="key" Content="0" /><Button Classes="key" Content="," /><Button Classes="key" Content="C" />
                                </UniformGrid>
                                <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                    <Button Classes="secondary" Content="Teclado" Margin="0,0,4,0" Height="40" />
                                    <Button Grid.Column="1" Classes="secondary" Content="Funciones" Margin="4,0,0,0" Height="40" />
                                </Grid>
                                <Button Classes="primary" Content="Intro" Height="46"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Grid>

                <Border Grid.Row="2" Classes="card" Margin="0,10,0,0" Padding="10,8">
                    <WrapPanel>
                        <Button Classes="fkey" Content="F2  Ticket" />
                        <Button Classes="fkey" Content="F3  Consulta" />
                        <Button Classes="fkey" Content="F4  Artículo" />
                        <Button Classes="fkey" Content="F5  Rápido" />
                        <Button Classes="fkey" Content="F6  Aparcar" />
                        <Button Classes="fkey" Content="F7  Recuperar" />
                        <Button Classes="fkey" Content="F8  Pago" />
                        <Button Classes="fkey" Content="Esc  Inicio"
                                Command="{Binding NavigateCommand}" CommandParameter="inicio" />
                    </WrapPanel>
                </Border>
            </Grid>

            <!-- PLACEHOLDER MODULES -->
            <Grid IsVisible="{Binding IsPlaceholder}">
                <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="40,36" MaxWidth="480">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding PlaceholderTitle}" Classes="section-title" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PlaceholderHint}" Classes="caption" TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button Classes="secondary" Content="Volver a Inicio" Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding NavigateCommand}" CommandParameter="inicio" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
