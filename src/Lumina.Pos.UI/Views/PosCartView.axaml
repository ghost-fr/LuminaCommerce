<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.PosCartView"
             x:DataType="vm:PosCartViewModel"
             Background="#0B1220">

  <Grid RowDefinitions="48,*,56,28" ColumnDefinitions="*" Margin="6">

    <Border Grid.Row="0" Background="#121A2B" CornerRadius="8" Padding="10,0" Margin="0,0,0,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="TIENDA" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StoreLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="CAJA" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RegisterLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="TICKET" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TicketNumber, TargetNullValue=—}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="CAJERO" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CashierLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding PrinterStatus, StringFormat='Imp. {0}'}" FontSize="11" Foreground="#6BCB77" />
          <TextBlock Text="{Binding ScaleStatus, StringFormat='Bal. {0}'}" FontSize="11" Foreground="#6BCB77" />
        </StackPanel>
        <Border Grid.Column="6" Background="#1B8FB5" CornerRadius="8" Padding="16,4" MinWidth="150">
          <StackPanel HorizontalAlignment="Right">
            <TextBlock Text="TOTAL" FontSize="10" Foreground="#93C5FD" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,300,200">

      <Grid Grid.Column="0" RowDefinitions="Auto,*,130" Margin="0,0,6,0">

        <Border Grid.Row="0" Background="#121A2B" CornerRadius="8" Padding="8" Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,72,96">
            <TextBox Watermark="Escanear o teclear código de barras…"
                     Text="{Binding BarcodeInput}"
                     FontSize="18" MinHeight="48"
                     Background="#0B1220" Foreground="#F3F4F6"
                     IsEnabled="{Binding !SaleCompleted}" />
            <TextBox Grid.Column="1" Text="{Binding QuantityInput}" Margin="6,0,0,0"
                     FontSize="18" MinHeight="48" HorizontalContentAlignment="Center"
                     Background="#0B1220" IsEnabled="{Binding !SaleCompleted}" />
            <Button Grid.Column="2" Content="AÑADIR" Command="{Binding AddLineCommand}"
                    Margin="6,0,0,0" MinHeight="48" FontWeight="Bold" FontSize="14"
                    Background="#1B8FB5" Foreground="White" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#121A2B" CornerRadius="8" Margin="0,0,0,6">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#1A2030" Padding="10,8">
              <Grid ColumnDefinitions="64,*,72,56,56,80,36">
                <TextBlock Text="CÓD." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" />
                <TextBlock Grid.Column="1" Text="ARTÍCULO" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" />
                <TextBlock Grid.Column="2" Text="PRECIO" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="CANT." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="DTO." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="IMPORTE" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLineItem">
                  <Border BorderBrush="#1A2030" BorderThickness="0,0,0,1" Padding="10,10">
                    <Grid ColumnDefinitions="64,*,72,56,56,80,36">
                      <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="#F9FAFB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}" FontSize="13"
                                 Foreground="#E5E7EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat='{}{0:N2}'}" FontSize="13"
                                 Foreground="#E5E7EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Discount, StringFormat='{}{0:N2}'}" FontSize="13"
                                 Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="Bold"
                                 Foreground="#F9FAFB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <Button Grid.Column="6" Content="✕" Padding="6,2" FontSize="12"
                              Command="{Binding $parent[UserControl].((vm:PosCartViewModel)DataContext).RemoveLineCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Department pad — each key adds a priced line -->
        <Border Grid.Row="2" Background="#121A2B" CornerRadius="8" Padding="6">
          <UniformGrid Columns="4" Rows="2">
            <Button Content="FRUTA 1,99" Command="{Binding AddQuickProductCommand}" CommandParameter="FRUTA"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="VARIOS 0,50" Command="{Binding AddQuickProductCommand}" CommandParameter="VARIOS"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="PAN 1,20" Command="{Binding AddQuickProductCommand}" CommandParameter="PAN"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="CERVEZA 1,50" Command="{Binding AddQuickProductCommand}" CommandParameter="CERVEZA"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="LÁCTEOS 2,10" Command="{Binding AddQuickProductCommand}" CommandParameter="LACTEOS"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="CARNES 8,90" Command="{Binding AddQuickProductCommand}" CommandParameter="CARNES"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="BEBIDAS 1,80" Command="{Binding AddQuickProductCommand}" CommandParameter="BEBIDAS"
                    Margin="3" MinHeight="48" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="BALANZA" Command="{Binding ReadScaleCommand}"
                    Margin="3" MinHeight="48" FontWeight="Bold" Background="#0E7490" Foreground="White" />
          </UniformGrid>
        </Border>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="0,0,6,0">

        <Border Grid.Row="0" Background="#121A2B" CornerRadius="8" Padding="12" Margin="0,0,0,6">
          <StackPanel Spacing="5">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Subtotal" Foreground="#9CA3AF" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:N2}'}" Foreground="#F3F4F6" FontSize="13" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="IVA" Foreground="#9CA3AF" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{Binding VatTotal, StringFormat='{}{0:N2}'}" Foreground="#F3F4F6" FontSize="13" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Descuento" Foreground="#9CA3AF" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{Binding DiscountTotal, StringFormat='{}{0:N2}'}" Foreground="#F3F4F6" FontSize="13" />
            </Grid>
            <Border Height="1" Background="#1F2937" Margin="0,2" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="18" Foreground="#F9FAFB" />
              <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontWeight="Bold" FontSize="20" Foreground="#7DD3E8" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Efectivo" Foreground="#6B7280" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding TenderCash, StringFormat='{}{0:N2}'}" Foreground="#D1D5DB" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Tarjeta" Foreground="#6B7280" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding TenderCard, StringFormat='{}{0:N2}'}" Foreground="#D1D5DB" FontSize="12" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#0B1220" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="{Binding KeypadTarget}" FontSize="11" Foreground="#64748B"
                       VerticalAlignment="Center" Margin="0,0,10,0" Width="56" />
            <TextBlock Grid.Column="1" Text="{Binding KeypadBuffer}"
                       FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       MinHeight="32" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#121A2B" CornerRadius="8" Padding="6">
          <Grid RowDefinitions="36,*,*,*,*,40" ColumnDefinitions="*,*,*">
            <Button Grid.Row="0" Grid.Column="0" Content="Cant." Margin="2"
                    Command="{Binding SetKeypadTargetCommand}" CommandParameter="Quantity"
                    FontSize="12" FontWeight="SemiBold" Background="#334155" Foreground="#F1F5F9" />
            <Button Grid.Row="0" Grid.Column="1" Content="Precio" Margin="2"
                    Command="{Binding SetKeypadTargetCommand}" CommandParameter="Price"
                    FontSize="12" FontWeight="SemiBold" Background="#334155" Foreground="#F1F5F9" />
            <Button Grid.Row="0" Grid.Column="2" Content="Dto." Margin="2"
                    Command="{Binding SetKeypadTargetCommand}" CommandParameter="Discount"
                    FontSize="12" FontWeight="SemiBold" Background="#334155" Foreground="#F1F5F9" />

            <Button Grid.Row="1" Grid.Column="0" Content="7" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="7" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="8" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="9" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="0" Content="4" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="4" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="5" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="6" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="0" Content="1" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="1" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="2" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="3" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="0" Content="0" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="0" FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="1" Content="00" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="00" FontSize="18" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="2" Content="," Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="," FontSize="22" FontWeight="SemiBold" Background="#1E293B" Foreground="#F8FAFC" />

            <Button Grid.Row="5" Grid.Column="0" Content="C" Margin="2" Command="{Binding KeypadClearCommand}" FontSize="16" FontWeight="Bold" Background="#475569" Foreground="White" />
            <Button Grid.Row="5" Grid.Column="1" Content="⌫" Margin="2" Command="{Binding KeypadBackspaceCommand}" FontSize="16" FontWeight="Bold" Background="#475569" Foreground="White" />
            <Button Grid.Row="5" Grid.Column="2" Content="INTRO" Margin="2" Command="{Binding KeypadEnterCommand}" FontSize="13" FontWeight="Bold" Background="#7C3AED" Foreground="White" />
          </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,6,0,0">
          <Button Content="F8  EFECTIVO" Command="{Binding PayCashCommand}" HorizontalAlignment="Stretch" MinHeight="42" FontWeight="SemiBold" Background="#065F46" Foreground="#ECFDF5" />
          <Button Content="F9  TARJETA" Command="{Binding PayCardCommand}" HorizontalAlignment="Stretch" MinHeight="42" FontWeight="SemiBold" Background="#1E3A5F" Foreground="#DBEAFE" />
          <Button Content="F10 MIXTO" Command="{Binding PayMixedCommand}" HorizontalAlignment="Stretch" MinHeight="38" FontWeight="SemiBold" Background="#1E293B" Foreground="#E5E7EB" />
          <Button Content="F12  COBRAR" Command="{Binding CompleteSaleCommand}" HorizontalAlignment="Stretch" MinHeight="52" FontSize="17" FontWeight="Bold" Background="#16A34A" Foreground="White" />
        </StackPanel>
      </Grid>

      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,6">
          <ScrollViewer>
            <StackPanel Spacing="3">
              <TextBlock Text="FACTURA SIMPLIFICADA" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
              <TextBlock Text="{Binding StoreLabel}" FontSize="11" Foreground="#334155" />
              <TextBlock Text="{Binding TicketNumber, StringFormat='Nº {0}', TargetNullValue='Nº —'}" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="{Binding CashierLabel, StringFormat='Cajero: {0}'}" FontSize="11" Foreground="#64748B" />
              <Border Height="1" Background="#CBD5E1" Margin="0,6" />
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLineItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Text="{Binding ProductName}" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="#0F172A" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Height="1" Background="#CBD5E1" Margin="0,6" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
              </Grid>
              <TextBlock Text="{Binding PaymentLabel, StringFormat='Pago: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" />
              <TextBlock Text="{Binding QrPayload}" FontSize="9" Foreground="#64748B" TextWrapping="Wrap"
                         FontFamily="Consolas, Courier New, monospace" IsVisible="{Binding SaleCompleted}" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Background="#121A2B" CornerRadius="8" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock Text="VERI*FACTU" FontWeight="Bold" FontSize="11" Foreground="#93C5FD" />
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Estado" FontSize="11" Foreground="#6B7280" />
              <TextBlock Grid.Column="1" Text="{Binding VeriFactuEstado}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" Margin="8,0,0,0" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Nº" FontSize="11" Foreground="#6B7280" />
              <TextBlock Grid.Column="1" Text="{Binding VeriFactuCodigo}" FontSize="11" Foreground="#D1D5DB" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#121A2B" CornerRadius="8" Padding="4" Margin="0,6,0,0">
      <UniformGrid Columns="8">
        <Button Content="F3 Clientes" Command="{Binding FunctionClientesCommand}" Margin="3" MinHeight="44" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F4 Productos" Command="{Binding FunctionProductosCommand}" Margin="3" MinHeight="44" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F5 Descuento" Command="{Binding FunctionDescuentoCommand}" Margin="3" MinHeight="44" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F6 Observ." Command="{Binding FunctionObservacionesCommand}" Margin="3" MinHeight="44" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F7 Cajón" Command="{Binding FunctionCajonCommand}" Margin="3" MinHeight="44" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Balanza" Command="{Binding ReadScaleCommand}" Margin="3" MinHeight="44" Background="#0E7490" Foreground="White" FontWeight="SemiBold" />
        <Button Content="Nuevo ticket" Command="{Binding NewSaleCommand}" Margin="3" MinHeight="44" Background="#374151" Foreground="White" FontWeight="SemiBold" />
        <Button Content="Cód. barras" Command="{Binding SetKeypadTargetCommand}" CommandParameter="Barcode" Margin="3" MinHeight="44" Background="#1E293B" Foreground="#93C5FD" />
      </UniformGrid>
    </Border>

    <Border Grid.Row="3" Background="#0B1220" Padding="10,4" Margin="0,4,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
