<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.PosCartView"
             x:DataType="vm:PosCartViewModel"
             Background="#0B1220">

  <Grid RowDefinitions="52,*,52,26" ColumnDefinitions="*" Margin="8">

    <!-- ═══ BARRA DE SESIÓN ═══ -->
    <Border Grid.Row="0" Background="#111827" CornerRadius="10" Padding="14,0" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="TIENDA" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StoreLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="CAJA" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RegisterLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="TICKET" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TicketNumber, TargetNullValue=—}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="CAJERO" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CashierLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#F3F4F6" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="{Binding PrinterStatus, StringFormat='Imp. {0}'}" FontSize="11" Foreground="#34D399" />
          <TextBlock Text="{Binding ScaleStatus, StringFormat='Bal. {0}'}" FontSize="11" Foreground="#34D399" />
        </StackPanel>
        <Border Grid.Column="6" Background="#0EA5E9" CornerRadius="10" Padding="18,6" MinWidth="160">
          <StackPanel HorizontalAlignment="Right">
            <TextBlock Text="TOTAL" FontSize="10" Foreground="#E0F2FE" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ═══ SUPERFICIE PRINCIPAL ═══ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,320,210">

      <!-- IZQUIERDA: ticket + secciones -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,120" Margin="0,0,8,0">

        <Border Grid.Row="0" Background="#111827" CornerRadius="10" Padding="10" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,70,100">
            <TextBox Watermark="Escanear o teclear código…"
                     Text="{Binding BarcodeInput}"
                     FontSize="17" MinHeight="46"
                     Background="#0B1220" Foreground="#F8FAFC"
                     IsEnabled="{Binding !SaleCompleted}" />
            <TextBox Grid.Column="1" Text="{Binding QuantityInput}" Margin="8,0,0,0"
                     FontSize="17" MinHeight="46" HorizontalContentAlignment="Center"
                     Background="#0B1220" IsEnabled="{Binding !SaleCompleted}" />
            <Button Grid.Column="2" Content="AÑADIR" Command="{Binding AddLineCommand}"
                    Margin="8,0,0,0" MinHeight="46" FontWeight="Bold" FontSize="14"
                    Background="#0EA5E9" Foreground="White" CornerRadius="8" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="#111827" CornerRadius="10" Margin="0,0,0,8">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#1F2937" Padding="12,8" CornerRadius="10,10,0,0">
              <Grid ColumnDefinitions="70,*,70,56,56,80,36">
                <TextBlock Text="CÓD." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" />
                <TextBlock Grid.Column="1" Text="ARTÍCULO" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" />
                <TextBlock Grid.Column="2" Text="PRECIO" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="CANT." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="DTO." FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="IMPORTE" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLineItem">
                  <Border BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,11">
                    <Grid ColumnDefinitions="70,*,70,56,56,80,36">
                      <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"
                                 Foreground="#F9FAFB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}" FontSize="13"
                                 Foreground="#E5E7EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat='{}{0:N2}'}" FontSize="13"
                                 Foreground="#E5E7EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Discount, StringFormat='{}{0:N2}'}" FontSize="13"
                                 Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="Bold"
                                 Foreground="#F9FAFB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <Button Grid.Column="6" Content="✕" Padding="6,2" FontSize="12"
                              Command="{Binding $parent[UserControl].((vm:PosCartViewModel)DataContext).RemoveLineCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#111827" CornerRadius="10" Padding="6">
          <UniformGrid Columns="4" Rows="2">
            <Button Content="FRUTA 1,99" Command="{Binding AddQuickProductCommand}" CommandParameter="FRUTA"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="VARIOS 0,50" Command="{Binding AddQuickProductCommand}" CommandParameter="VARIOS"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="PAN 1,20" Command="{Binding AddQuickProductCommand}" CommandParameter="PAN"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="CERVEZA 1,50" Command="{Binding AddQuickProductCommand}" CommandParameter="CERVEZA"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="LÁCTEOS 2,10" Command="{Binding AddQuickProductCommand}" CommandParameter="LACTEOS"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="CARNES 8,90" Command="{Binding AddQuickProductCommand}" CommandParameter="CARNES"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="BEBIDAS 1,80" Command="{Binding AddQuickProductCommand}" CommandParameter="BEBIDAS"
                    Margin="3" MinHeight="46" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Content="BALANZA" Command="{Binding ReadScaleCommand}"
                    Margin="3" MinHeight="46" FontWeight="Bold" CornerRadius="8" Background="#0E7490" Foreground="White" />
          </UniformGrid>
        </Border>
      </Grid>

      <!-- ═══ CENTRO: TOTALES + TECLADO + PAGO ═══ -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="0,0,8,0">

        <!-- Totales -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="10" Padding="14" Margin="0,0,0,8">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Subtotal" Foreground="#9CA3AF" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:N2}'}" Foreground="#F3F4F6" FontSize="13" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="IVA" Foreground="#9CA3AF" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{Binding VatTotal, StringFormat='{}{0:N2}'}" Foreground="#F3F4F6" FontSize="13" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Descuento" Foreground="#9CA3AF" FontSize="13" />
              <TextBlock Grid.Column="1" Text="{Binding DiscountTotal, StringFormat='{}{0:N2}'}" Foreground="#F3F4F6" FontSize="13" />
            </Grid>
            <Border Height="1" Background="#374151" Margin="0,4" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="20" Foreground="#F9FAFB" />
              <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontWeight="Bold" FontSize="22" Foreground="#38BDF8" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
              <TextBlock Text="Efectivo" Foreground="#6B7280" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding TenderCash, StringFormat='{}{0:N2}'}" Foreground="#D1D5DB" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Tarjeta" Foreground="#6B7280" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding TenderCard, StringFormat='{}{0:N2}'}" Foreground="#D1D5DB" FontSize="12" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Display del teclado -->
        <Border Grid.Row="1" Background="#030712" BorderBrush="#374151" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*">
            <Border Background="#1F2937" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
              <TextBlock Text="{Binding KeypadTarget}" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding KeypadBuffer}"
                       FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       MinHeight="36" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <!--
          TECLADO NUMÉRICO — layout profesional 6×3
          Fila 0: modo (Cant / Precio / Dto)
          Filas 1–4: 7-9 / 4-6 / 1-3 / 0 00 ,
          Fila 5: C / ⌫ / INTRO
        -->
        <Border Grid.Row="2" Background="#111827" CornerRadius="10" Padding="8">
          <Grid RowDefinitions="34,*,*,*,*,42" ColumnDefinitions="*,*,*" RowSpacing="4" ColumnSpacing="4">

            <!-- Modo -->
            <Button Grid.Row="0" Grid.Column="0" Content="Cantidad"
                    Command="{Binding SetKeypadTargetCommand}" CommandParameter="Quantity"
                    FontSize="12" FontWeight="SemiBold" CornerRadius="6"
                    Background="#374151" Foreground="#F1F5F9" />
            <Button Grid.Row="0" Grid.Column="1" Content="Precio"
                    Command="{Binding SetKeypadTargetCommand}" CommandParameter="Price"
                    FontSize="12" FontWeight="SemiBold" CornerRadius="6"
                    Background="#374151" Foreground="#F1F5F9" />
            <Button Grid.Row="0" Grid.Column="2" Content="Dto."
                    Command="{Binding SetKeypadTargetCommand}" CommandParameter="Discount"
                    FontSize="12" FontWeight="SemiBold" CornerRadius="6"
                    Background="#374151" Foreground="#F1F5F9" />

            <!-- 7 8 9 -->
            <Button Grid.Row="1" Grid.Column="0" Content="7" Command="{Binding KeypadDigitCommand}" CommandParameter="7"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Command="{Binding KeypadDigitCommand}" CommandParameter="8"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Command="{Binding KeypadDigitCommand}" CommandParameter="9"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />

            <!-- 4 5 6 -->
            <Button Grid.Row="2" Grid.Column="0" Content="4" Command="{Binding KeypadDigitCommand}" CommandParameter="4"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Command="{Binding KeypadDigitCommand}" CommandParameter="5"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Command="{Binding KeypadDigitCommand}" CommandParameter="6"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />

            <!-- 1 2 3 -->
            <Button Grid.Row="3" Grid.Column="0" Content="1" Command="{Binding KeypadDigitCommand}" CommandParameter="1"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Command="{Binding KeypadDigitCommand}" CommandParameter="2"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Command="{Binding KeypadDigitCommand}" CommandParameter="3"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />

            <!-- 0 00 , -->
            <Button Grid.Row="4" Grid.Column="0" Content="0" Command="{Binding KeypadDigitCommand}" CommandParameter="0"
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="1" Content="00" Command="{Binding KeypadDigitCommand}" CommandParameter="00"
                    FontSize="20" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="2" Content="," Command="{Binding KeypadDigitCommand}" CommandParameter=","
                    FontSize="24" FontWeight="SemiBold" CornerRadius="8" Background="#1E293B" Foreground="#F8FAFC" />

            <!-- C  ⌫  INTRO -->
            <Button Grid.Row="5" Grid.Column="0" Content="Borrar" Command="{Binding KeypadClearCommand}"
                    FontSize="13" FontWeight="Bold" CornerRadius="8" Background="#4B5563" Foreground="White" />
            <Button Grid.Row="5" Grid.Column="1" Content="⌫" Command="{Binding KeypadBackspaceCommand}"
                    FontSize="18" FontWeight="Bold" CornerRadius="8" Background="#4B5563" Foreground="White" />
            <Button Grid.Row="5" Grid.Column="2" Content="INTRO" Command="{Binding KeypadEnterCommand}"
                    FontSize="13" FontWeight="Bold" CornerRadius="8" Background="#7C3AED" Foreground="White" />
          </Grid>
        </Border>

        <!-- Pagos -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
          <Button Content="EFECTIVO" Command="{Binding PayCashCommand}"
                  HorizontalAlignment="Stretch" MinHeight="44" FontSize="15" FontWeight="Bold"
                  CornerRadius="8" Background="#047857" Foreground="#ECFDF5" />
          <Button Content="TARJETA" Command="{Binding PayCardCommand}"
                  HorizontalAlignment="Stretch" MinHeight="44" FontSize="15" FontWeight="Bold"
                  CornerRadius="8" Background="#1D4ED8" Foreground="#DBEAFE" />
          <Button Content="MIXTO" Command="{Binding PayMixedCommand}"
                  HorizontalAlignment="Stretch" MinHeight="40" FontSize="14" FontWeight="SemiBold"
                  CornerRadius="8" Background="#334155" Foreground="#E2E8F0" />
          <Button Content="COBRAR" Command="{Binding CompleteSaleCommand}"
                  HorizontalAlignment="Stretch" MinHeight="54" FontSize="18" FontWeight="Bold"
                  CornerRadius="10" Background="#16A34A" Foreground="White" />
        </StackPanel>
      </Grid>

      <!-- DERECHA: ticket + VeriFactu -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,8">
          <ScrollViewer>
            <StackPanel Spacing="3">
              <TextBlock Text="FACTURA SIMPLIFICADA" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
              <TextBlock Text="{Binding StoreLabel}" FontSize="11" Foreground="#334155" />
              <TextBlock Text="{Binding TicketNumber, StringFormat='Nº {0}', TargetNullValue='Nº —'}" FontSize="11" Foreground="#64748B" />
              <TextBlock Text="{Binding CashierLabel, StringFormat='Cajero: {0}'}" FontSize="11" Foreground="#64748B" />
              <Border Height="1" Background="#CBD5E1" Margin="0,6" />
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLineItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Text="{Binding ProductName}" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="#0F172A" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Height="1" Background="#CBD5E1" Margin="0,6" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
              </Grid>
              <TextBlock Text="{Binding PaymentLabel, StringFormat='Pago: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" />
              <TextBlock Text="{Binding QrPayload}" FontSize="9" Foreground="#64748B" TextWrapping="Wrap"
                         FontFamily="Consolas, Courier New, monospace" IsVisible="{Binding SaleCompleted}" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Background="#111827" CornerRadius="10" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="VERI*FACTU" FontWeight="Bold" FontSize="11" Foreground="#7DD3FC" />
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Estado" FontSize="11" Foreground="#6B7280" />
              <TextBlock Grid.Column="1" Text="{Binding VeriFactuEstado}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="8,0,0,0" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Nº" FontSize="11" Foreground="#6B7280" />
              <TextBlock Grid.Column="1" Text="{Binding VeriFactuCodigo}" FontSize="11" Foreground="#D1D5DB" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ═══ BARRA DE FUNCIONES ═══ -->
    <Border Grid.Row="2" Background="#111827" CornerRadius="10" Padding="6" Margin="0,8,0,0">
      <UniformGrid Columns="8">
        <Button Content="Clientes" Command="{Binding FunctionClientesCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Productos" Command="{Binding FunctionProductosCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Descuento" Command="{Binding FunctionDescuentoCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Observar" Command="{Binding FunctionObservacionesCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Cajón" Command="{Binding FunctionCajonCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Balanza" Command="{Binding ReadScaleCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#0E7490" Foreground="White" FontWeight="SemiBold" />
        <Button Content="Nuevo ticket" Command="{Binding NewSaleCommand}"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#475569" Foreground="White" FontWeight="SemiBold" />
        <Button Content="Cód. barras" Command="{Binding SetKeypadTargetCommand}" CommandParameter="Barcode"
                Margin="3" MinHeight="40" CornerRadius="8" Background="#1E293B" Foreground="#7DD3FC" />
      </UniformGrid>
    </Border>

    <Border Grid.Row="3" Background="Transparent" Padding="8,4" Margin="0,4,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#7DD3FC" VerticalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
