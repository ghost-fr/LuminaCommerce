<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.PosCartView"
             x:DataType="vm:PosCartViewModel">

    <Grid ColumnDefinitions="2*,*" Margin="16" RowDefinitions="Auto,*,Auto">

        <!-- Scan bar — primary focus for keyboard / scanner -->
        <Border Grid.ColumnSpan="2" Background="#1A1A28" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox x:Name="BarcodeBox"
                         Watermark="Barcode / SKU (scanner or type + Enter)"
                         Text="{Binding BarcodeInput}"
                         FontSize="18"
                         MinHeight="44"
                         IsEnabled="{Binding !SaleCompleted}" />
                <NumericUpDown Grid.Column="1"
                               Value="{Binding QuantityInput}"
                               Minimum="0.01"
                               Increment="1"
                               Width="100"
                               Margin="8,0,0,0"
                               IsEnabled="{Binding !SaleCompleted}" />
                <Button Grid.Column="2"
                        Content="Add"
                        Command="{Binding AddLineCommand}"
                        Margin="8,0,0,0"
                        MinWidth="80" />
                <Button Grid.Column="3"
                        Content="New sale (F9)"
                        Command="{Binding NewSaleCommand}"
                        Margin="8,0,0,0"
                        MinWidth="110" />
            </Grid>
        </Border>

        <!-- Cart lines -->
        <Border Grid.Row="1" Background="#1A1A28" CornerRadius="8" Padding="8" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Cart" FontWeight="SemiBold" Margin="4,4,4,8" />
                <ListBox ItemsSource="{Binding Lines}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CartLineItem">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Barcode}" Foreground="#888" FontSize="12" />
                                    <TextBlock Text="{Binding PromoBadge}" Foreground="#6BCB77" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Quantity, StringFormat='{}{0:N2}'}"
                                           VerticalAlignment="Center"
                                           Margin="12,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding LineTotal, StringFormat='{}{0:N2}'}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="12,0" />
                                <Button Grid.Column="3"
                                        Content="✕"
                                        Command="{Binding $parent[UserControl].((vm:PosCartViewModel)DataContext).RemoveLineCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4"
                                        ToolTip.Tip="Remove line (reversible)" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Totals + tender + irreversible charge -->
        <Border Grid.Row="1" Grid.Column="1" Background="#1A1A28" CornerRadius="8" Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="Totals" FontWeight="SemiBold" />
                <!-- Amounts from backend only -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Subtotal" />
                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:N2}'}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="VAT" />
                    <TextBlock Grid.Column="1" Text="{Binding VatTotal, StringFormat='{}{0:N2}'}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Total" FontWeight="Bold" FontSize="18" />
                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="18" />
                </Grid>

                <Separator Margin="0,8" />

                <TextBlock Text="Tender" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Cash" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Column="1" Value="{Binding TenderCash}" Minimum="0" FormatString="N2" />
                    <TextBlock Grid.Row="1" Text="Card" VerticalAlignment="Center" Margin="0,8,8,0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TenderCard}" Minimum="0" FormatString="N2" Margin="0,8,0,0" />
                    <Button Grid.Row="2" Grid.ColumnSpan="2"
                            Content="Exact cash"
                            Command="{Binding ExactCashCommand}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" />
                </Grid>

                <!-- Irreversible: visual weight distinct from tender buttons -->
                <Button Content="COBRAR / Complete sale (F8)"
                        Command="{Binding CompleteSaleCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        MinHeight="52"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#1B7A4A"
                        Foreground="White"
                        Margin="0,12,0,0"
                        ToolTip.Tip="Commits the sale and fiscal record — cannot be undone from this screen" />

                <!-- Status first, then opaque ticket tokens as received -->
                <Border IsVisible="{Binding SaleCompleted}"
                        Background="#1E3A2F"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SaleStatusLabel}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#6BCB77" />
                        <TextBlock Text="{Binding TicketNumber}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas, Courier New, monospace" />
                        <TextBlock Text="QR payload (exact backend string — render only)"
                                   Foreground="#A0A0B0"
                                   FontSize="11" />
                        <TextBlock Text="{Binding QrPayload}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Status + next action -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="#1E2A3A">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="#E8F0FF" />
                <TextBlock Text="{Binding StatusHint}"
                           TextWrapping="Wrap"
                           Foreground="#A0C4FF"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
