<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.PosCartView"
             x:DataType="vm:PosCartViewModel"
             Background="#0B1220">
  <Grid RowDefinitions="44,*,56,24" Margin="6">
    <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="12,0" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="TPV" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StoreLabel}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="Caja" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RegisterLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="Ticket" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TicketNumber, TargetNullValue=—}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Cajero" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CashierLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding PrinterStatus, StringFormat='Imp:{0}'}" FontSize="11" Foreground="#34D399" />
          <TextBlock Text="{Binding ScaleStatus, StringFormat='Bal:{0}'}" FontSize="11" Foreground="#38BDF8" />
        </StackPanel>
        <Border Grid.Column="6" Background="#0369A1" CornerRadius="8" Padding="16,6" MinWidth="150">
          <StackPanel HorizontalAlignment="Right">
            <TextBlock Text="TOTAL" FontSize="9" Foreground="#BAE6FD" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,300,200">
      <Grid Grid.Column="0" RowDefinitions="Auto,*,100" Margin="0,0,6,0">
        <Border Grid.Row="0" Background="#111827" CornerRadius="8" Padding="8" Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,56,96">
            <TextBox Watermark="Código de barras / artículo…" Text="{Binding BarcodeInput}" FontSize="16" MinHeight="42" Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" IsEnabled="{Binding !SaleCompleted}" />
            <TextBox Grid.Column="1" Text="{Binding QuantityInput}" Margin="6,0,0,0" FontSize="16" MinHeight="42" HorizontalContentAlignment="Center" Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" IsEnabled="{Binding !SaleCompleted}" />
            <Button Grid.Column="2" Content="AÑADIR" Command="{Binding AddLineCommand}" Margin="6,0,0,0" MinHeight="42" FontWeight="Bold" FontSize="13" Background="#0284C7" Foreground="White" CornerRadius="6" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#111827" CornerRadius="8" Margin="0,0,0,6" ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#1E293B" Padding="10,8" CornerRadius="8,8,0,0">
              <Grid ColumnDefinitions="68,*,64,52,48,76,32">
                <TextBlock Text="CÓDIGO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="1" Text="ARTÍCULO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="2" Text="PRECIO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="CANT." FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="DTO." FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="IMPORTE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLineItem">
                  <Border BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="10,10">
                    <Grid ColumnDefinitions="68,*,64,52,48,76,32">
                      <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}" FontSize="13" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat='{}{0:N2}'}" FontSize="13" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Discount, StringFormat='{}{0:N2}'}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <Button Grid.Column="6" Content="✕" Padding="2" FontSize="12" Background="Transparent" Foreground="#F87171" Command="{Binding $parent[UserControl].((vm:PosCartViewModel)DataContext).RemoveLineCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="6">
          <UniformGrid Columns="4" Rows="2">
            <Button Content="FRUTA 1,99" Command="{Binding AddQuickProductCommand}" CommandParameter="FRUTA" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="VARIOS 0,50" Command="{Binding AddQuickProductCommand}" CommandParameter="VARIOS" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="PAN 1,20" Command="{Binding AddQuickProductCommand}" CommandParameter="PAN" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="CERVEZA 1,50" Command="{Binding AddQuickProductCommand}" CommandParameter="CERVEZA" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="LÁCTEOS 2,10" Command="{Binding AddQuickProductCommand}" CommandParameter="LACTEOS" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="CARNES 8,90" Command="{Binding AddQuickProductCommand}" CommandParameter="CARNES" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="BEBIDAS 1,80" Command="{Binding AddQuickProductCommand}" CommandParameter="BEBIDAS" Margin="3" MinHeight="40" FontWeight="SemiBold" FontSize="12" CornerRadius="6" Background="#1E293B" Foreground="#F1F5F9" />
            <Button Content="BALANZA" Command="{Binding ReadScaleCommand}" Margin="3" MinHeight="40" FontWeight="Bold" FontSize="12" CornerRadius="6" Background="#0E7490" Foreground="White" />
          </UniformGrid>
        </Border>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="0,0,6,0">
        <Border Grid.Row="0" Background="#111827" CornerRadius="8" Padding="12" Margin="0,0,0,6">
          <StackPanel Spacing="5">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Subtotal" Foreground="#94A3B8" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:N2}'}" Foreground="#F1F5F9" FontSize="12" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="IVA" Foreground="#94A3B8" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding VatTotal, StringFormat='{}{0:N2}'}" Foreground="#F1F5F9" FontSize="12" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Descuento" Foreground="#94A3B8" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding DiscountTotal, StringFormat='{}{0:N2}'}" Foreground="#F1F5F9" FontSize="12" /></Grid>
            <Border Height="1" Background="#334155" Margin="0,3" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="TOTAL" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" /><TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontWeight="Bold" FontSize="20" Foreground="#38BDF8" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Efectivo" Foreground="#64748B" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TenderCash, StringFormat='{}{0:N2}'}" Foreground="#CBD5E1" FontSize="11" /></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tarjeta" Foreground="#64748B" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding TenderCard, StringFormat='{}{0:N2}'}" Foreground="#CBD5E1" FontSize="11" /></Grid>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#020617" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
          <Grid ColumnDefinitions="Auto,*">
            <Border Background="#1E3A5F" CornerRadius="4" Padding="8,4"><TextBlock Text="{Binding KeypadTarget}" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" /></Border>
            <TextBlock Grid.Column="1" Text="{Binding KeypadBuffer}" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="6">
          <Grid RowDefinitions="36,*,*,*,*,44" ColumnDefinitions="*,*,*">
            <Button Grid.Row="0" Grid.Column="0" Content="Cant." Margin="2" Command="{Binding SetKeypadTargetCommand}" CommandParameter="Quantity" FontSize="11" FontWeight="SemiBold" CornerRadius="5" Background="#334155" Foreground="#F1F5F9" />
            <Button Grid.Row="0" Grid.Column="1" Content="Precio" Margin="2" Command="{Binding SetKeypadTargetCommand}" CommandParameter="Price" FontSize="11" FontWeight="SemiBold" CornerRadius="5" Background="#334155" Foreground="#F1F5F9" />
            <Button Grid.Row="0" Grid.Column="2" Content="Dto." Margin="2" Command="{Binding SetKeypadTargetCommand}" CommandParameter="Discount" FontSize="11" FontWeight="SemiBold" CornerRadius="5" Background="#334155" Foreground="#F1F5F9" />
            <Button Grid.Row="1" Grid.Column="0" Content="7" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="7" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="8" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="9" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="0" Content="4" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="4" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="5" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="6" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="0" Content="1" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="1" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="2" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="3" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="0" Content="0" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="0" FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="1" Content="00" Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="00" FontSize="16" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="4" Grid.Column="2" Content="," Margin="2" Command="{Binding KeypadDigitCommand}" CommandParameter="," FontSize="20" FontWeight="SemiBold" CornerRadius="6" Background="#1E293B" Foreground="#F8FAFC" />
            <Button Grid.Row="5" Grid.Column="0" Content="C" Margin="2" Command="{Binding KeypadClearCommand}" FontSize="13" FontWeight="Bold" CornerRadius="6" Background="#475569" Foreground="White" />
            <Button Grid.Row="5" Grid.Column="1" Content="⌫" Margin="2" Command="{Binding KeypadBackspaceCommand}" FontSize="14" FontWeight="Bold" CornerRadius="6" Background="#475569" Foreground="White" />
            <Button Grid.Row="5" Grid.Column="2" Content="INTRO" Margin="2" Command="{Binding KeypadEnterCommand}" FontSize="12" FontWeight="Bold" CornerRadius="6" Background="#7C3AED" Foreground="White" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="5" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,*,*">
            <Button Grid.Column="0" Content="EFECTIVO F8" Command="{Binding PayCashCommand}" Margin="0,0,3,0" MinHeight="44" FontSize="12" FontWeight="Bold" CornerRadius="6" Background="#047857" Foreground="#ECFDF5" />
            <Button Grid.Column="1" Content="TARJETA F9" Command="{Binding PayCardCommand}" Margin="1.5,0" MinHeight="44" FontSize="12" FontWeight="Bold" CornerRadius="6" Background="#1D4ED8" Foreground="#DBEAFE" />
            <Button Grid.Column="2" Content="MIXTO F10" Command="{Binding PayMixedCommand}" Margin="3,0,0,0" MinHeight="44" FontSize="12" FontWeight="Bold" CornerRadius="6" Background="#334155" Foreground="#E2E8F0" />
          </Grid>
          <Button Content="COBRAR  F12" Command="{Binding CompleteSaleCommand}" HorizontalAlignment="Stretch" MinHeight="52" FontSize="17" FontWeight="Bold" CornerRadius="8" Background="#16A34A" Foreground="White" />
        </StackPanel>
      </Grid>

      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,6">
          <ScrollViewer>
            <StackPanel Spacing="3">
              <TextBlock Text="FACTURA SIMPLIFICADA" FontWeight="Bold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding StoreLabel}" FontSize="10" Foreground="#334155" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding TicketNumber, StringFormat='Nº {0}', TargetNullValue='En curso…'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding CashierLabel, StringFormat='Cajero: {0}'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" />
              <Border Height="1" Background="#CBD5E1" Margin="0,6" />
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLineItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock Text="{Binding ProductName}" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Height="1" Background="#CBD5E1" Margin="0,6" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
              </Grid>
              <TextBlock Text="{Binding PaymentLabel, StringFormat='Pago: {0}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Background="#111827" CornerRadius="8" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock Text="ESTADO TICKET" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding VeriFactuEstado}" FontSize="12" FontWeight="SemiBold" Foreground="#86EFAC" />
            <TextBlock Text="{Binding TicketNumber, TargetNullValue=—}" FontSize="11" Foreground="#E2E8F0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="4" Margin="0,6,0,0" BorderBrush="#1E293B" BorderThickness="1">
      <UniformGrid Columns="8">
        <Button Content="F3 Clientes" Command="{Binding FunctionClientesCommand}" Margin="2" MinHeight="40" FontSize="11" CornerRadius="6" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F4 Productos" Command="{Binding FunctionProductosCommand}" Margin="2" MinHeight="40" FontSize="11" CornerRadius="6" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F5 Descuento" Command="{Binding FunctionDescuentoCommand}" Margin="2" MinHeight="40" FontSize="11" CornerRadius="6" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F6 Observar" Command="{Binding FunctionObservacionesCommand}" Margin="2" MinHeight="40" FontSize="11" CornerRadius="6" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="F7 Cajón" Command="{Binding FunctionCajonCommand}" Margin="2" MinHeight="40" FontSize="11" CornerRadius="6" Background="#1E293B" Foreground="#E5E7EB" />
        <Button Content="Balanza" Command="{Binding ReadScaleCommand}" Margin="2" MinHeight="40" FontSize="11" FontWeight="SemiBold" CornerRadius="6" Background="#0E7490" Foreground="White" />
        <Button Content="Nuevo ticket" Command="{Binding NewSaleCommand}" Margin="2" MinHeight="40" FontSize="11" FontWeight="SemiBold" CornerRadius="6" Background="#475569" Foreground="White" />
        <Button Content="Cód. barras" Command="{Binding SetKeypadTargetCommand}" CommandParameter="Barcode" Margin="2" MinHeight="40" FontSize="11" CornerRadius="6" Background="#1E293B" Foreground="#7DD3FC" />
      </UniformGrid>
    </Border>

    <Border Grid.Row="3" Padding="8,2">
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#7DD3FC" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
