<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.StockView"
             x:DataType="vm:StockViewModel">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16">
            <TextBlock Text="Stock" FontSize="20" FontWeight="SemiBold" />

            <Border Background="#3A2A10" CornerRadius="6" Padding="12">
                <TextBlock Text="{Binding BackendBanner}"
                           TextWrapping="Wrap"
                           Foreground="#F0C060" />
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding FilterText}"
                         Watermark="Filter barcode or name…"
                         MinHeight="36" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="8,0,0,0"
                        Padding="16,8" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#A0A0B0" />

            <DataGrid ItemsSource="{Binding Balances}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      Height="220"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#333">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" />
                    <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*" />
                    <DataGridTextColumn Header="On hand" Binding="{Binding OnHand}" Width="90" />
                    <DataGridTextColumn Header="Reserved" Binding="{Binding Reserved}" Width="90" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid ColumnDefinitions="*,*" IsEnabled="{Binding CanAdjust}">
                <Border Grid.Column="0" Background="#1A1A28" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Adjust (+/-)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding AdjustBarcode}" Watermark="Barcode" />
                        <TextBox Text="{Binding AdjustDeltaText}" Watermark="Delta (e.g. -2 or 5)" />
                        <TextBox Text="{Binding AdjustNote}" Watermark="Reason note" />
                        <Button Content="Apply adjust" Command="{Binding AdjustCommand}" Padding="12,8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1A1A28" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Physical count" FontWeight="SemiBold" />
                        <TextBox Text="{Binding CountBarcode}" Watermark="Barcode" />
                        <TextBox Text="{Binding CountQtyText}" Watermark="Counted quantity" />
                        <TextBox Text="{Binding CountNote}" Watermark="Reason note" />
                        <Button Content="Set count" Command="{Binding CountCommand}" Padding="12,8" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
