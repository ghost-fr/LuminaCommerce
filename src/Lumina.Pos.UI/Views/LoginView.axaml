<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource Brush.Canvas}">
    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                CornerRadius="14"
                BoxShadow="0 12 40 0 #14000000">
            <StackPanel>
                <Border Background="#111827" CornerRadius="14,14,0,0" Padding="28,26">
                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource Brush.Brand}">
                            <TextBlock Text="L" FontSize="22" FontWeight="Bold" Foreground="#111827"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Lumina Commerce" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Punto de venta · VeriFactu" FontSize="12" Foreground="#9CA3AF" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12" Margin="32,28,32,32">
                    <TextBlock Text="Iniciar sesión" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Accede con tu usuario de tienda" Classes="caption" Margin="0,0,0,8" />

                    <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkMuted}" />
                    <TextBox Classes="field" Watermark="Nombre de usuario"
                             Text="{Binding Username}" IsEnabled="{Binding !IsBusy}" />

                    <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0" />
                    <TextBox Classes="field" Watermark="Contraseña" PasswordChar="•"
                             Text="{Binding Password}" IsEnabled="{Binding !IsBusy}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource Brush.Danger}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Button Content="Entrar" Classes="primary" Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="44" Margin="0,10,0,0" />

                    <TextBlock Text="Entorno de desarrollo · admin / changeme"
                               Classes="muted" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
