<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="#F4F6F8">
    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                Padding="0"
                CornerRadius="12"
                Background="White"
                BorderBrush="#E6EBF0"
                BorderThickness="1"
                BoxShadow="0 8 32 0 #1A000000">
            <StackPanel>
                <!-- Brand header -->
                <Border Background="#1A1A1A" CornerRadius="12,12,0,0" Padding="28,24">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Border Background="#F5A623" CornerRadius="8" Width="44" Height="44">
                            <TextBlock Text="L" FontSize="22" FontWeight="Bold"
                                       Foreground="#1A1A1A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lumina" FontSize="22" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Commerce POS" FontSize="12" Foreground="#AAAAAA" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="14" Margin="32,28,32,32">
                    <TextBlock Text="Iniciar sesión" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A1A" />
                    <TextBlock Text="Introduce tus credenciales para continuar"
                               FontSize="13" Foreground="#6B7280" Margin="0,0,0,6" />

                    <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold" Foreground="#3D4A5C" />
                    <TextBox Classes="field"
                             Watermark="admin"
                             Text="{Binding Username}"
                             IsEnabled="{Binding !IsBusy}" />

                    <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Foreground="#3D4A5C" />
                    <TextBox Classes="field"
                             Watermark="••••••••"
                             Text="{Binding Password}"
                             PasswordChar="•"
                             IsEnabled="{Binding !IsBusy}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               FontSize="13"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Button Content="Entrar"
                            Classes="primary"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="44"
                            Margin="0,8,0,0" />

                    <TextBlock Text="Dev: admin / changeme"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
