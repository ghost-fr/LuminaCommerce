<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.ModulePlaceholderView"
             x:DataType="vm:ModulePlaceholderViewModel">

    <Border Margin="32" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#161B22" CornerRadius="12" Padding="28" BorderBrush="#21262D" BorderThickness="1">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Text="{Binding Description}" Foreground="#8B949E" TextWrapping="Wrap" />
            <Border Background="#0F1117" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <TextBlock Text="{Binding BlueprintNote}"
                           Foreground="#6E7681"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </Border>
            <TextBlock Text="{Binding ModuleId, StringFormat='Module id: {0}'}"
                       FontFamily="Consolas, Courier New, monospace"
                       FontSize="11"
                       Foreground="#484F58" />
        </StackPanel>
    </Border>
</UserControl>
