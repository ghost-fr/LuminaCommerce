<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumina.Pos.UI.ViewModels"
             x:Class="Lumina.Pos.UI.Views.MainPlaceholderView"
             x:DataType="vm:MainPlaceholderViewModel">

    <StackPanel Margin="32" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Greeting}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <TextBlock Text="POS cart & sale screen (Phase 3 UI) will live here."
                   Foreground="#888"
                   TextWrapping="Wrap"
                   MaxWidth="480"
                   HorizontalAlignment="Center" />

        <Border Background="#2A2A3A" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Capabilities" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CapabilitiesSummary}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="13" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
