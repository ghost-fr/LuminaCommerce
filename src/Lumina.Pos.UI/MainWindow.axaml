<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumina.Pos.UI.ViewModels"
        xmlns:views="using:Lumina.Pos.UI.Views"
        x:Class="Lumina.Pos.UI.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Lumina Commerce"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:PosCartViewModel">
            <views:PosCartView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainPlaceholderViewModel">
            <views:MainPlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="vm:ModulePlaceholderViewModel">
            <views:ModulePlaceholderView />
        </DataTemplate>
    </Window.DataTemplates>

    <!-- Login: full window -->
    <Panel>
        <ContentControl Content="{Binding CurrentContent}"
                        IsVisible="{Binding !IsLoggedIn}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- Logged-in shell: MainForm spine -->
        <DockPanel IsVisible="{Binding IsLoggedIn}">

            <!-- Header / branding (blueprint §3 Header) -->
            <Border DockPanel.Dock="Top"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Background="#2F81F7" CornerRadius="6" Width="28" Height="28" />
                        <TextBlock Text="Lumina Commerce"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="#E6EDF3" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CompanyDisplay}"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0"
                               Foreground="#8B949E" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding UserDisplay}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Foreground="#E6EDF3" />

                    <Button Grid.Column="4"
                            Content="Sign out"
                            Command="{Binding LogoutCommand}"
                            Padding="14,6" />
                </Grid>
            </Border>

            <!-- Status bar (blueprint §3 Footer/status) -->
            <Border DockPanel.Dock="Bottom"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,1,0,0"
                    Padding="12,6">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#8B949E"
                           FontSize="12" />
            </Border>

            <!-- Left quick-access panel (blueprint §3 Left panel / ExplorerBar) -->
            <Border DockPanel.Dock="Left"
                    Width="260"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding NavGroups}" Margin="8,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavGroupViewModel">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#8B949E"
                                               Margin="8,0,8,6"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NavItemViewModel">
                                                <Button Command="{Binding OpenCommand}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="10,8"
                                                        Margin="0,1">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#E6EDF3"
                                                                   FontSize="13" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="#6E7681"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Center content (blueprint §3 MDI / main content) -->
            <Border Background="#0F1117" Padding="0">
                <ContentControl Content="{Binding CurrentContent}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
            </Border>
        </DockPanel>
    </Panel>
</Window>
