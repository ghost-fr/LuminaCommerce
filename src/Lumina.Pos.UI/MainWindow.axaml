<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumina.Pos.UI.ViewModels"
        xmlns:views="using:Lumina.Pos.UI.Views"
        x:Class="Lumina.Pos.UI.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Lumina POS"
        Width="1440" Height="900"
        MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:PosCartViewModel">
            <views:PosCartView />
        </DataTemplate>
        <DataTemplate DataType="vm:CatalogueViewModel">
            <views:CatalogueView />
        </DataTemplate>
        <DataTemplate DataType="vm:StockViewModel">
            <views:StockView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainPlaceholderViewModel">
            <views:MainPlaceholderView />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#12161F"
                Padding="14,10"
                IsVisible="{Binding IsLoggedIn}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="Lumina POS"
                           FontWeight="Bold"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Foreground="#F9FAFB"
                           Margin="0,0,20,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Caja / TPV"
                            Command="{Binding NavigateRegisterCommand}"
                            IsVisible="{Binding CanOperateRegister}"
                            Padding="14,8"
                            FontWeight="SemiBold"
                            Background="#1E293B"
                            Foreground="#F3F4F6" />
                    <Button Content="Catálogo"
                            Command="{Binding NavigateCatalogueCommand}"
                            IsVisible="{Binding CanBrowseCatalogue}"
                            Padding="14,8"
                            Background="#1E293B"
                            Foreground="#D1D5DB" />
                    <Button Content="Stock"
                            Command="{Binding NavigateStockCommand}"
                            IsVisible="{Binding CanManageStock}"
                            Padding="14,8"
                            Background="#1E293B"
                            Foreground="#D1D5DB" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           Margin="0,0,16,0" />

                <Button Grid.Column="3"
                        Content="Cerrar sesión"
                        Command="{Binding LogoutCommand}"
                        Padding="14,8"
                        Background="#374151"
                        Foreground="White" />
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentContent}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
    </DockPanel>
</Window>
