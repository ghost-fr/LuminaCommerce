<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumina.Pos.UI.ViewModels"
        xmlns:views="using:Lumina.Pos.UI.Views"
        x:Class="Lumina.Pos.UI.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Lumina POS"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#12121A">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:PosCartViewModel">
            <views:PosCartView />
        </DataTemplate>
        <DataTemplate DataType="vm:CatalogueViewModel">
            <views:CatalogueView />
        </DataTemplate>
        <DataTemplate DataType="vm:StockViewModel">
            <views:StockView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainPlaceholderViewModel">
            <views:MainPlaceholderView />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#1A1A28"
                Padding="12,8"
                IsVisible="{Binding IsLoggedIn}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="Lumina POS"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,24,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Register"
                            Command="{Binding NavigateRegisterCommand}"
                            IsVisible="{Binding CanOperateRegister}"
                            Padding="12,6" />
                    <Button Content="Catalogue"
                            Command="{Binding NavigateCatalogueCommand}"
                            IsVisible="{Binding CanBrowseCatalogue}"
                            Padding="12,6" />
                    <Button Content="Stock"
                            Command="{Binding NavigateStockCommand}"
                            IsVisible="{Binding CanManageStock}"
                            Padding="12,6" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#A0A0B0"
                           Margin="0,0,16,0" />

                <Button Grid.Column="3"
                        Content="Sign out"
                        Command="{Binding LogoutCommand}"
                        Padding="12,6" />
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentContent}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
    </DockPanel>
</Window>
