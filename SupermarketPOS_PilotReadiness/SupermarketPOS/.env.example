# Copy to .env and fill in real values locally. .env is git-ignored.
# Never commit real secrets — this file only documents required keys.

LUMINA_ENV=Development

# NEW: which kind of build this is — Development | Pilot | Production.
# Unset/unrecognized defaults to Development (no extra checks run). Setting
# this to Pilot or Production activates PilotSafetyGuard, which refuses to
# start if the loaded Tenant's NIF matches Lumina.SeedDev's demo default —
# a real safety mechanism preventing a pilot/production build from
# accidentally running against seed/demo data. See
# src/Lumina.Application/Configuration/PilotSafetyGuard.cs.
LUMINA_BUILD_MODE=Development

# Connection string for local SQLite (Development) or Postgres/SQL Server (Staging/Prod)
LUMINA_DB_CONNECTION=Data Source=lumina.dev.db

# REQUIRED as of the composition-root commit — no default, App.axaml.cs throws on
# startup without this. There is no setup/seed flow yet: manually insert a Tenant
# row into the SQLite DB (see src/Lumina.Domain/Identity/Tenant.cs) and set this to
# its Id. A real onboarding/setup screen is a follow-up, not yet built.
LUMINA_TENANT_ID=

# AEAT VeriFactu client certificate (path + passphrase), Staging/Prod only
AEAT_CLIENT_CERT_PATH=
AEAT_CLIENT_CERT_PASSPHRASE=
AEAT_ENVIRONMENT=sandbox   # sandbox | production

# Symmetric key used to encrypt local config at rest
LUMINA_CONFIG_ENCRYPTION_KEY=
